<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<VBox spacing="12" alignment="CENTER" style="-fx-padding: 25;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="be.feastord.feastord.frontend.controller.ModifierReservationController">

    <Label text="Modifier la réservation" style="-fx-font-size: 20px;"/>

    <DatePicker fx:id="datePicker"/>

    <ComboBox fx:id="heureComboBox"/>

    <Spinner fx:id="nombreClientSpinner"/>

    <TextArea fx:id="commentaireField"/>

    <Button text="Enregistrer"
            onAction="#enregistrerModification"/>

</VBox>
