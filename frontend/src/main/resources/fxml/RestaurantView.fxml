<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="be.FeastOrd.Frontend.controller.RestaurantController"
      spacing="20"
      styleClass="content-pane">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="Gestion des Restaurants" styleClass="section-title"/>
    
    <HBox spacing="10">
        <Button text="Actualiser" fx:id="btnActualiser" onAction="#actualiserRestaurants" styleClass="action-button"/>
    </HBox>
    
    <TableView fx:id="restaurantTable" styleClass="data-table">
        <columns>
            <TableColumn text="ID" fx:id="colId" prefWidth="50"/>
            <TableColumn text="Nom" fx:id="colNom" prefWidth="200"/>
            <TableColumn text="Étoiles" fx:id="colEtoiles" prefWidth="80"/>
            <TableColumn text="Ville" fx:id="colVille" prefWidth="150"/>
            <TableColumn text="Rue" fx:id="colRue" prefWidth="200"/>
            <TableColumn text="Code Postal" fx:id="colCodePostal" prefWidth="100"/>
        </columns>
    </TableView>
    
    <Separator/>
    
    <Label text="Formulaire" styleClass="form-title"/>
    
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="150"/>
            <ColumnConstraints minWidth="200" prefWidth="300" hgrow="ALWAYS"/>
        </columnConstraints>
        
        <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNom" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Étoiles:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtEtoiles" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Ville:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtVille" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label text="Rue:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtRue" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Code Postal:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtCodePostal" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>
    
    <HBox spacing="10">
        <Button text="Ajouter" fx:id="btnAjouter" onAction="#ajouterRestaurant" styleClass="primary-button"/>
        <Button text="Modifier" fx:id="btnModifier" onAction="#modifierRestaurant" styleClass="secondary-button"/>
        <Button text="Supprimer" fx:id="btnSupprimer" onAction="#supprimerRestaurant" styleClass="danger-button"/>
    </HBox>
    
</VBox>
